# Global build arg - available to all FROM lines.
# Must NOT have ENV here; ENV is a layer instruction and cannot precede FROM.
ARG BASE_IMAGE_TAG="${BASE_IMAGE_TAG:-latest}"
ARG BASE_IMAGE_REPO="quay.io/rakuos/rakuos-base-v3"

# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /

# Base Image (stessa base usata da rakuos-niri)
FROM ${BASE_IMAGE_REPO}:${BASE_IMAGE_TAG}

### ISA LEVEL & OCI LABELS (x86-64-v3)
LABEL os.isa_level="v3"
LABEL org.opencontainers.image.base.isa="v3"

RUN sed -i 's/^ID=.*/ID=fedora/' /etc/os-release && \
    echo "ISA_LEVEL=v3" >> /etc/os-release

### MODIFICATIONS
COPY --from=ghcr.io/ublue-os/brew:latest /system_files /
RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /usr/bin/systemctl preset brew-setup.service && \
    /usr/bin/systemctl preset brew-update.timer && \
    /usr/bin/systemctl preset brew-upgrade.timer

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-amd.sh

# Install after build scripts so this configuration cannot be overwritten by them.
COPY --from=ctx /usr/lib/bootc/kargs.d/10-rakuos.toml /usr/lib/bootc/kargs.d/10-rakuos.toml

# bootc lint rejects stale runtime state; keep the cleanup narrow and safe.
# We only delete the known gluster runtime dir and any broken chcon symlinks,
# without touching the systemd-managed files under /run.
RUN rm -rf /run/gluster /tmp/* /var/tmp/* || true && \
    [ -L /usr/sbin/chcon ] && rm -f /usr/sbin/chcon || true && \
    [ -L /usr/bin/chcon ] && rm -f /usr/bin/chcon || true && \
    mkdir -p /run /tmp /var/tmp && \
    chmod 1777 /tmp /var/tmp

### LINTING
RUN bootc container lint
